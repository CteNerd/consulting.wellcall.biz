{
  "name": "consulting.wellcall.biz",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "apps/api",
    "apps/web",
    "infra"
  ],
  "dependencies": {
    "@ant-design/icons": "^4.4.0",
    "@testing-library/jest-dom": "^5.11.9",
    "@testing-library/react": "^11.2.3",
    "@testing-library/user-event": "^12.6.0",
    "@types/jest": "^26.0.20",
    "@types/node": "^12.19.14",
    "@types/react": "^16.14.2",
    "@types/react-dom": "^16.9.10",
    "antd": "^4.16.13",
    "prettier": "^2.2.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-scripts": "4.0.3",
    "typescript": "^4.1.3",
    "web-vitals": "^0.2.4"
  },
  "scripts": {
    "check:foundation": "npm run check --workspaces",
    "build:web": "npm run build --workspace @rct/consulting-web",
    "dev:web": "npm run dev --workspace @rct/consulting-web",
    "cdk:synth:development": "npm run synth:development --workspace @rct/consulting-infra",
    "cdk:synth:production": "npm run synth:production --workspace @rct/consulting-infra",
    "test:contracts": "npm run check --workspace @rct/portfolio-contracts && node packages/contracts/src/verify-pin.ts",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "format": "prettier --write \"**/*.+(js|jsx|ts|tsx|json|yml|yaml|css|md|vue)\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "eslint@7": {
      "minimatch": "3.1.5",
      "semver": "7.8.6"
    }
  },
  "devDependencies": {
    "@types/react-router-dom": "^5.1.7",
    "react-router-dom": "^5.2.0"
  }
}
