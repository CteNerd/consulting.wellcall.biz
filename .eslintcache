        <Packages />\n            </Route>\n            <Route path=\"/services\">\n              <Services />\n            </Route>\n            <Route path=\"/\">\n              <Home />\n            </Route>\n          </Switch>\n        </Router>\n      </div>\n\n      <footer className=\"App-footer\">\n        <div className=\"col-33\">\n          <a href={\"mailto:admin@wellcall.biz\"}>\n            <MailOutlined />\n          </a>\n        </div>\n        <div className=\"col-33\">\n          <button\n            type=\"submit\"\n            onClick={() =>\n              window.open(\"https://facebook.com/WellCallTechConsulting\", \"_blank\")\n            }\n          >\n            Schedule An Appointment Now\n          </button>\n        </div>\n        <div className=\"col-33\">\n          <a href={\"tel:559-574-1056\"}>\n            <PhoneOutlined />\n          </a>\n        </div>\n      </footer>\n    </div>\n  );\n}\n\n/* Set the width of the side navigation to 250px */\nfunction openNav() {\n  if (document.getElementById(\"mySidenav\")) {\n    document.getElementById(\"mySidenav\")!.style.width = \"200px\";\n  }\n}\n\nexport default App;\n","/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/consulting.wellcall.biz/src/main/home/home.tsx",["43","44"],"import React from \"react\";\nimport code from \"../../images/vscode.jpg\";\nimport ceiling from \"../../images/glassCeiling.jpg\";\nimport \"./home.css\";\nimport { UsergroupAddOutlined, UserOutlined } from \"@ant-design/icons\";\n\nexport default function Home() {\n  return (\n    <div className={\"home\"}>\n      <h2>\n        Need Help With Technology?\n        <br />\n        <strong>We'll Call</strong> With Answers\n      </h2>\n      <div className={\"cards\"}>\n        <div className={\"\"}>\n          <img src={ceiling} />\n        </div>\n        <div className={\"info\"}>\n          <h3>\n            <UserOutlined className={\"title-icon\"} />\n            Personal\n          </h3>\n          <ul>\n            <li>Build a website for yourself or your r&eacute;sum&eacute;</li>\n            <li>Build your social media presence</li>\n            <li>Highlight Films of your awesome season</li>\n            <li>Hardware or Software Questions</li>\n            <li>Smart Home and Personal Home Security Assistance</li>\n            <li>And more...</li>\n          </ul>\n        </div>\n        <div className={\"info\"}>\n          <h3>\n            <UsergroupAddOutlined className={\"title-icon\"} />\n            Small Business\n          </h3>\n          <ul>\n            <li>Establish your business digitally with a website and domain</li>\n            <li>Emails and Addresses are delivered professionally</li>\n            <li>Control the ads your customers will see</li>\n            <li>Search Engine Optimization</li>\n            <li>Hardware or Software Questions</li>\n            <li>And more...</li>\n          </ul>\n        </div>\n        <img src={code} />\n      </div>\n    </div>\n  );\n}\n","/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/consulting.wellcall.biz/src/main/side-nav/sideNav.tsx",["45","46","47","48","49","50"],"import React, { useState } from \"react\";\nimport {\n  CaretDownOutlined,\n  HomeOutlined,\n  GithubOutlined,\n  InfoCircleOutlined,\n  UsergroupAddOutlined,\n  InstagramOutlined,\n  FacebookOutlined,\n  AppstoreAddOutlined,\n  SolutionOutlined,\n} from \"@ant-design/icons\";\nimport \"./sideNav.css\";\n\nexport default function SideNav() {\n  const [showProjectsDropdown, setShowProjectsDropdown] = useState(false);\n  const [showSocialDropdown, setShowSocialDropdown] = useState(false);\n\n  function closeNav() {\n    if (document.getElementById(\"mySidenav\"))\n      document.getElementById(\"mySidenav\")!.style.width = \"0\";\n  }\n\n  return (\n    <div id=\"mySidenav\" className=\"sidenav\">\n      <div className=\"closebtn\" onClick={closeNav}>\n        &times;\n      </div>\n      <a href=\"/\">\n        <HomeOutlined /> Home\n      </a>\n      <a href=\"/about\">\n        <InfoCircleOutlined /> About\n      </a>\n      <a href=\"/services\">\n        <AppstoreAddOutlined /> Services\n      </a>\n      <a href=\"/packages\">\n        <SolutionOutlined /> Packages\n      </a>\n      <button\n        onClick={() => setShowProjectsDropdown(!showProjectsDropdown)}\n        className=\"dropdown-btn\"\n      >\n        <GithubOutlined /> Projects\n        <CaretDownOutlined className={\"fa-caret-down\"} />\n      </button>\n      <div\n        className=\"dropdown-container\"\n        style={{ display: showProjectsDropdown ? \"block\" : \"none\" }}\n      >\n        <a href=\"https://ttyltutors.com\" target=\"_blank\">TTYL</a>\n        <a href=\"https://pearlrae.com\" target=\"_blank\">Pearl Rae</a>\n        <a href=\"https://jimmyjamkalewraps.com\" target=\"_blank\">Jimmy Jam Kale Wrap</a>\n        <a href=\"https://tix.wellcall.biz\" target=\"_blank\">We'll Call Tix</a>\n      </div>\n      <button\n        onClick={() => setShowSocialDropdown(!showSocialDropdown)}\n        className=\"dropdown-btn\"\n      >\n        <UsergroupAddOutlined /> Social\n        <CaretDownOutlined className={\"fa-caret-down\"} />\n      </button>\n      <div\n        className=\"dropdown-container\"\n        style={{ display: showSocialDropdown ? \"block\" : \"none\" }}\n      >\n        <a\n          href=\"https://www.facebook.com/WellCallTechConsulting\"\n          target={\"_blank\"}\n        >\n          <FacebookOutlined /> Facebook\n        </a>\n        <a href=\"https://www.instagram.com/d.o.n._tomlin/\" target={\"_blank\"}>\n          <InstagramOutlined /> Instagram\n        </a>\n      </div>\n    </div>\n  );\n}\n","/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/consulting.wellcall.biz/src/main/about/about.tsx",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/consulting.wellcall.biz/src/main/services/services.tsx",["51","52","53","54"],"import {\n  CrownOutlined,\n  LaptopOutlined,\n  TabletOutlined,\n  WifiOutlined,\n} from \"@ant-design/icons\";\nimport React from \"react\";\nimport \"./services.css\";\nimport wifi from \"../../images/wifi at your palms.jpg\";\nimport ipad from \"../../images/ipad.jpg\";\nimport ttyl from \"../../images/ttyl_home.png\";\nimport fb from \"../../images/fb_biz_page.png\";\n\nexport default function Services() {\n  return (\n    <div className=\"services\">\n      <h2>Services</h2>\n      <div className=\"cards\">\n        <div className=\"col-50\">\n          <h3>\n            <LaptopOutlined className=\"icon\" />\n            Web Sites\n          </h3>\n          <ul>\n            <li>Domain Management</li>\n            <li>Database Management</li>\n            <li>Employee Emails</li>\n            <li>Subdomain Management</li>\n            <li>Api Documentation</li>\n            <li>Unit and Integration Testing</li>\n            <li>\n              Mobile App setup <strong>coming soon</strong>\n            </li>\n          </ul>\n        </div>\n        <div className=\"col-50\">\n          <img src={ttyl} />\n        </div>\n        <div className=\"col-50\">\n          <img src={wifi} />\n        </div>\n        <div className=\"col-50\">\n          <h3>\n            <WifiOutlined className=\"icon\" />\n            Wi-Fi\n          </h3>\n          <ul>\n            <li>Proper Speed For Your Business</li>\n            <li>Proper Modem/Router For Your Business</li>\n            <li>Wi-Fi Security</li>\n            <li>User Management</li>\n          </ul>\n        </div>\n        <div className=\"col-50\">\n          <h3>\n            <CrownOutlined className=\"icon\" />\n            Social Media\n          </h3>\n          <ul>\n            <li>Establish Business Accounts</li>\n            <li>Establish Business Profiles</li>\n            <li>Live Feed(s) From Social Media To Site</li>\n          </ul>\n        </div>\n        <div className=\"col-50\">\n          <img src={fb} />\n        </div>\n        <div className=\"col-50\">\n          <img src={ipad} />\n        </div>\n        <div className=\"col-50\">\n          <h3>\n            <TabletOutlined className=\"icon\" />\n            Device Setup\n          </h3>\n          <ul>\n            <li>Device Tutorial</li>\n            <li>Device Security</li>\n            <li>Password Security</li>\n            <li>Cloud Storage & Management</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  );\n}\n","/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/consulting.wellcall.biz/src/main/packages/packages.tsx",[],{"ruleId":"55","replacedBy":"56"},{"ruleId":"57","replacedBy":"58"},{"ruleId":"59","severity":1,"message":"60","line":3,"column":50,"nodeType":"61","messageId":"62","endLine":3,"endColumn":54},{"ruleId":"63","severity":1,"message":"64","line":23,"column":11,"nodeType":"65","endLine":23,"endColumn":53},{"ruleId":"63","severity":1,"message":"64","line":17,"column":11,"nodeType":"65","endLine":17,"endColumn":32},{"ruleId":"63","severity":1,"message":"64","line":47,"column":9,"nodeType":"65","endLine":47,"endColumn":27},{"ruleId":"66","severity":1,"message":"67","line":52,"column":9,"nodeType":"65","endLine":52,"endColumn":58},{"ruleId":"66","severity":1,"message":"67","line":53,"column":9,"nodeType":"65","endLine":53,"endColumn":56},{"ruleId":"66","severity":1,"message":"67","line":54,"column":9,"nodeType":"65","endLine":54,"endColumn":65},{"ruleId":"66","severity":1,"message":"67","line":55,"column":9,"nodeType":"65","endLine":55,"endColumn":60},{"ruleId":"66","severity":1,"message":"67","line":68,"column":9,"nodeType":"65","endLine":71,"endColumn":10},{"ruleId":"66","severity":1,"message":"67","line":74,"column":9,"nodeType":"65","endLine":74,"endColumn":78},{"ruleId":"63","severity":1,"message":"64","line":37,"column":11,"nodeType":"65","endLine":37,"endColumn":29},{"ruleId":"63","severity":1,"message":"64","line":40,"column":11,"nodeType":"65","endLine":40,"endColumn":29},{"ruleId":"63","severity":1,"message":"64","line":66,"column":11,"