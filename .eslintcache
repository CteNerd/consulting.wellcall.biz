mlin62/consulting.wellcall.biz/src/reportWebVitals.ts",[],"/Users/rtomlin62/consulting.wellcall.biz/src/App.tsx",["64","65"],"/Users/rtomlin62/consulting.wellcall.biz/src/main/about/about.tsx",[],"/Users/rtomlin62/consulting.wellcall.biz/src/main/side-nav/sideNav.tsx",["66","67","68","69","70","71"],"/Users/rtomlin62/consulting.wellcall.biz/src/main/services/services.tsx",["72","73","74","75"],"import {\n  CrownOutlined,\n  LaptopOutlined,\n  TabletOutlined,\n  WifiOutlined,\n} from \"@ant-design/icons\";\nimport React from \"react\";\nimport \"./services.css\";\nimport wifi from \"../../images/wifi at your palms.jpg\";\nimport ipad from \"../../images/ipad.jpg\";\nimport ttyl from \"../../images/ttyl_home.png\";\nimport fb from \"../../images/fb_biz_page.png\";\n\nexport default function Services() {\n  return (\n    <div className=\"services\">\n      <h2>Services</h2>\n      <div className=\"cards\">\n        <div className=\"col-50\">\n          <h3>\n            <LaptopOutlined className=\"icon\" />\n            Web Sites\n          </h3>\n          <ul>\n            <li>Domain Management</li>\n            <li>Database Management</li>\n            <li>Employee Emails</li>\n            <li>Subdomain Management</li>\n            <li>Api Documentation</li>\n            <li>Unit and Integration Testing</li>\n            <li>\n              Mobile App setup <strong>coming soon</strong>\n            </li>\n          </ul>\n        </div>\n        <div className=\"col-50\">\n          <img src={ttyl} />\n        </div>\n        <div className=\"col-50\">\n          <img src={wifi} />\n        </div>\n        <div className=\"col-50\">\n          <h3>\n            <WifiOutlined className=\"icon\" />\n            Wi-Fi\n          </h3>\n          <ul>\n            <li>Proper Speed For Your Business</li>\n            <li>Proper Modem/Router For Your Business</li>\n            <li>Wi-Fi Security</li>\n            <li>User Management</li>\n          </ul>\n        </div>\n        <div className=\"col-50\">\n          <h3>\n            <CrownOutlined className=\"icon\" />\n            Social Media\n          </h3>\n          <ul>\n            <li>Establish Business Accounts</li>\n            <li>Establish Business Profiles</li>\n            <li>Live Feed(s) From Social Media To Site</li>\n          </ul>\n        </div>\n        <div className=\"col-50\">\n          <img src={fb} />\n        </div>\n        <div className=\"col-50\">\n          <img src={ipad} />\n        </div>\n        <div className=\"col-50\">\n          <h3>\n            <TabletOutlined className=\"icon\" />\n            Device Setup\n          </h3>\n          <ul>\n            <li>Device Tutorial</li>\n            <li>Device Security</li>\n            <li>Password Security</li>\n            <li>Cloud Storage & Management</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  );\n}\n","/Users/rtomlin62/consulting.wellcall.biz/src/main/home/home.tsx",["76","77"],"import React from \"react\";\nimport code from \"../../images/vscode.jpg\";\nimport ceiling from \"../../images/glassCeiling.jpg\";\nimport \"./home.css\";\nimport { UsergroupAddOutlined, UserOutlined } from \"@ant-design/icons\";\n\nexport default function Home() {\n  return (\n    <div className={\"home\"}>\n      <h2>\n        Need Help With Technology?\n        <br />\n        <strong>We'll Call</strong> With Answers\n      </h2>\n      <div className={\"cards\"}>\n        <div className={\"\"}>\n          <img src={ceiling} />\n        </div>\n        <div className={\"info\"}>\n          <h3>\n            <UserOutlined className={\"title-icon\"} />\n            Personal\n          </h3>\n          <ul>\n            <li>Build a website for yourself or your r&eacute;sum&eacute;</li>\n            <li>Build your social media presence</li>\n            <li>Highlight Films of your awesome season</li>\n            <li>Hardware or Software Questions</li>\n            <li>Smart Home and Personal Home Security Assistance</li>\n            <li>And more...</li>\n          </ul>\n        </div>\n        <div className={\"info\"}>\n          <h3>\n            <UsergroupAddOutlined className={\"title-icon\"} />\n            Small Business\n          </h3>\n          <ul>\n            <li>Establish your business digitally with a website and domain</li>\n            <li>Emails and Addresses are delivered professionally</li>\n            <li>Control the ads your customers will see</li>\n            <li>Search Engine Optimization</li>\n            <li>Hardware or Software Questions</li>\n            <li>And more...</li>\n          </ul>\n        </div>\n        <img src={code} />\n      </div>\n    </div>\n  );\n}\n","/Users/rtomlin62/consulting.wellcall.biz/src/main/faqs/index.tsx",[],"/Users/rtomlin62/consulting.wellcall.biz/src/main/payment/index.tsx",[],"/Users/rtomlin62/consulting.wellcall.biz/src/main/services/consult.tsx",[],"/Users/rtomlin62/consulting.wellcall.biz/src/main/services/adopt.tsx",[],"/Users/rtomlin62/consulting.wellcall.biz/src/main/services/implement.tsx",[],"/Users/rtomlin62/consulting.wellcall.biz/src/main/services/maintenance.tsx",[],"/Users/rtomlin62/consulting.wellcall.biz/src/main/services/enhancements.tsx",["78"],"import { List, Typography } from \"antd\";\nimport React from \"react\";\n\nexport default function Enhancements() {\n  const data = [\n    \"Enhancing existing hardware\",\n    \"Enhancing existing software\",\n    \"Manage upgrades of 3rd party hardware\",\n    \"Manage upgrades of 3rd party software\",\n  ];\n\n  return (\n    <div>\n      <h1>Enhancements</h1>\n\n      <p>\n        Once our clients have their site or business established they sometimes\n        think of things to add after the project is complete, this would be\n        known as enhancements. So if your websites need pictures adjusted,\n        policies changed, or maybe it is just time to update the computers;\n        We’ll Call can assist in all areas, giving you peace of mind. On our\n        side we consider this a new project within the same contract. We ask\n        that we go through a consultation to align resources for these\n        enhancements; however, if seen that it can be incorporated within the\n        current project, we will do so and avoid repetition of paperwork.\n      </p>\n\n      <h3>What are software enhancements? </h3>\n      <p>\n        Enhancements are changes made to an existing feature on your project.\n        For example, you have a website where users can buy your product. At\n        first, there was only one payment option for credit/debit cards. But an\n        enhancement to this feature would be adding the ability to pay with\n        Apple Pay, Crypto, etc.\n      </p>\n      <h3>What are hardware enhancements?</h3>\n      <p>\n        Even though they are not actual enhancements most of the time, We’ll\n        Call considers hardware maintenance as enhancements just as much as\n        adding hardware to an existing setup. Updating your computer to the\n        latest software to ensure security or adding an external monitor to\n        extend the display from your laptop, are all enhancements that will be\n        taken care of by We’ll Call.\n      </p>\n      <h3>\n        How do I know my software and/or hardware is truly secure from hackers?\n      </h3>\n      <p>\n        Hackers have many ways of penetrating your infrastructure. We’ll Call\n        follows industry standards to steer these attacks away and protect your\n        business. Technology is an ecosystem where communities work together to\n        build a better and safer tomorrow just as much as hackers have an\n        ecosystem to try and penetrate the technology. There are testing tools\n        and mechanisms that We’ll Call can provide during the implementation\n        phase to assist with validating security. These hours would be allocated\n        under Other. However, if the results are not up to you and your business\n        standards, We’ll Call doesn’t mind sitting with a 3rd Party to discuss\n        what actions need to be taken. Please remember, all 3rd Party Software\n        is added at the expense of the client after such client has approved.\n      </p>\n\n      <List\n        size={\"small\"}\n        header={<div>Services</div>}\n        bordered\n        dataSource={data}\n        renderItem={(item) => <List.Item>{item}</List.Item>}\n      />\n      <div className=\"col-50\">\n        <a href=\"/enhancements\">\n          <button type=\"submit\">Enhancements</button>\n        </a>\n      </div>\n      <div className=\"col-50\">\n        <a href=\"/\">\n          <button type=\"submit\">Home</button>\n        </a>\n      </div>\n    </div>\n  );\n}\n",{"ruleId":"79","replacedBy":"80"},{"ruleId":"81","replacedBy":"82"},{"ruleId":"83","severity":1,"message":"84","line":3,"column":50,"nodeType":"85","messageId":"86","endLine":3,"endColumn":54},{"ruleId":"87","severity":1,"message":"88","line":29,"column":11,"nodeType":"89","endLine":29,"endColumn":53},{"ruleId":"90","severity":1,"message":"91","line":68,"column":9,"nodeType":"89","endLine":68,"endColumn":58},{"ruleId":"90","severity":1,"message":"91","line":71,"column":9,"nodeType":"89","endLine":71,"endColumn":56},{"ruleId":"90","severity":1,"message":"91","line":74,"column":9,"nodeType":"89","endLine":74,"endColumn":60},{"ruleId":"90","severity":1,"message":"91","line":77,"column":9,"nodeType":"89","endLine":77,"endColumn":60},{"ruleId":"90","severity":1,"message":"91","line":92,"column":9,"nodeType":"89","endLine":95,"endColumn":10},{"ruleId":"90","severity":1,"message":"91","line":98,"column":9,"nodeType":"89","endLine":101,"endColumn":10},{"ruleId":"87","severity":1,"message":"88","line":37,"column":11,"nodeType":"89","endLine":37,"endColumn":29},{"ruleId":"87","severity":1,"message":"88","line":40,"column":11,"nodeType":"89","endLine":40,"endColumn":29},{"ruleId":"87","severity":1,"message":"88","line":66,"column":11,"nodeType":"89","endLine":66,"endColumn":27},{"ruleId":"87","severity":1,"message":"88","line":69,"column":11,"nodeType":"89","endLine":69,"endColumn":29},{"ruleId":"87","severity":1,"message":"88","line":17,"column":11,"nodeType":"89","endLine":17,"endColumn":32},{"ruleId":"87","severity":1,"message":"88","line":47,"column":9,"nodeType":"89","endLine":47,"endColumn":27},{"ruleId":"83","severity":1,"message":"92","line":1,"column":16,"nodeType":"85","messageId":"86","endLine":1,"endColumn":26},"no-native-reassign",["93"],"no-negated-in-lhs",["94"],"@typescript-eslint/no-unused-vars","'Link' is defined but never used.","Identifier","unusedVar","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" is a security risk: see https://html.spec.whatwg.org/multipage/links.html#link-type-noopener","'Typography' is defined but never used.","no-global-assign","no-unsafe-negation"]