ebookOutlined,\n} from \"@ant-design/icons\";\nimport \"./sideNav.css\";\n\nexport default function SideNav() {\n  const [showProjectsDropdown, setShowProjectsDropdown] = useState(false);\n  const [showSocialDropdown, setShowSocialDropdown] = useState(false);\n\n  function closeNav() {\n    if (document.getElementById(\"mySidenav\"))\n      document.getElementById(\"mySidenav\")!.style.width = \"0\";\n  }\n\n  return (\n    <div id=\"mySidenav\" className=\"sidenav\">\n      <div className=\"closebtn\" onClick={closeNav}>\n        &times;\n      </div>\n      <a href=\"/\">\n        <HomeOutlined /> Home\n      </a>\n      <a href=\"/about\">\n        <InfoCircleOutlined /> About\n      </a>\n      <button\n        onClick={() => setShowProjectsDropdown(!showProjectsDropdown)}\n        className=\"dropdown-btn\"\n      >\n        <GithubOutlined /> Projects\n        <CaretDownOutlined className={\"fa-caret-down\"} />\n      </button>\n      <div\n        className=\"dropdown-container\"\n        style={{ display: showProjectsDropdown ? \"block\" : \"none\" }}\n      >\n        <a href=\"https://ttyltutors.com\">TTYL</a>\n        <a href=\"https://www.pearlrae.com\">Pearl Rae</a>\n        <a href=\"https://jimmyjamkalewraps.com\">Jimmy Jam Kale Wrap</a>\n        <a href=\"https://tix.wellcall.biz\">We'll Call Tix</a>\n      </div>\n      <button\n        onClick={() => setShowSocialDropdown(!showSocialDropdown)}\n        className=\"dropdown-btn\"\n      >\n        <UsergroupAddOutlined /> Social\n        <CaretDownOutlined className={\"fa-caret-down\"} />\n      </button>\n      <div\n        className=\"dropdown-container\"\n        style={{ display: showSocialDropdown ? \"block\" : \"none\" }}\n      >\n        <a href=\"https://www.facebook.com/WellCallTechConsulting\" target={\"_blank\"}>\n          <FacebookOutlined /> Facebook\n        </a>\n        <a href=\"https://www.instagram.com/d.o.n._tomlin/\" target={\"_blank\"}>\n          <InstagramOutlined /> Instagram\n        </a>\n      </div>\n    </div>\n  );\n}\n",{"ruleId":"33","replacedBy":"34"},{"ruleId":"35","replacedBy":"36"},{"ruleId":"37","severity":1,"message":"38","line":3,"column":50,"nodeType":"39","messageId":"40","endLine":3,"endColumn":54},{"ruleId":"41","severity":1,"message":"42","line":22,"column":33,"nodeType":"43","endLine":22,"endColumn":75},{"ruleId":"41","severity":1,"message":"42","line":13,"column":11,"nodeType":"43","endLine":13,"endColumn":31},{"ruleId":"41","severity":1,"message":"42","line":46,"column":9,"nodeType":"43","endLine":46,"endColumn":26},{"ruleId":"44","severity":1,"message":"45","line":60,"column":9,"nodeType":"43","endLine":60,"endColumn":85},{"ruleId":"44","severity":1,"message":"45","line":63,"column":9,"nodeType":"43","endLine":63,"endColumn":78},"no-native-reassign",["46"],"no-negated-in-lhs",["47"],"@typescript-eslint/no-unused-vars","'Link' is defined but never used.","Identifier","unusedVar","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" is a security risk: see https://html.spec.whatwg.org/multipage/links.html#link-type-noopener","no-global-assign","no-unsafe-negation"]