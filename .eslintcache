l Business\n          </h3>\n          <ul>\n            <li>Establish your business digitally with a website and domain</li>\n            <li>Emails and Addresses are delivered professionally</li>\n            <li>Control the ads your customers will see</li>\n            <li>Search Engine Optimization</li>\n            <li>Hardware or Software Questions</li>\n            <li>And more...</li>\n          </ul>\n        </div>\n        <img src={code} />\n      </div>\n      <button\n        type=\"submit\"\n        onClick={() =>\n          window.open(\"https://facebook.com/WellCallTechConsulting\", \"_blank\")\n        }\n      >\n        Schedule An Appointment Now\n      </button>\n    </div>\n  );\n}\n","/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/consulting.wellcall.biz/src/main/side-nav/sideNav.tsx",["43","44"],"import React, { useState } from \"react\";\nimport {\n  CaretDownOutlined,\n  HomeOutlined,\n  GithubOutlined,\n  InfoCircleOutlined,\n  UsergroupAddOutlined,\n  InstagramOutlined,\n  FacebookOutlined,\n  AppstoreAddOutlined,\n  SolutionOutlined,\n} from \"@ant-design/icons\";\nimport \"./sideNav.css\";\n\nexport default function SideNav() {\n  const [showProjectsDropdown, setShowProjectsDropdown] = useState(false);\n  const [showSocialDropdown, setShowSocialDropdown] = useState(false);\n\n  function closeNav() {\n    if (document.getElementById(\"mySidenav\"))\n      document.getElementById(\"mySidenav\")!.style.width = \"0\";\n  }\n\n  return (\n    <div id=\"mySidenav\" className=\"sidenav\">\n      <div className=\"closebtn\" onClick={closeNav}>\n        &times;\n      </div>\n      <a href=\"/\">\n        <HomeOutlined /> Home\n      </a>\n      <a href=\"/about\">\n        <InfoCircleOutlined /> About\n      </a>\n      <a href=\"/services\">\n        <AppstoreAddOutlined /> Services\n      </a>\n      <a href=\"/packages\">\n        <SolutionOutlined /> Packages\n      </a>\n      <button\n        onClick={() => setShowProjectsDropdown(!showProjectsDropdown)}\n        className=\"dropdown-btn\"\n      >\n        <GithubOutlined /> Projects\n        <CaretDownOutlined className={\"fa-caret-down\"} />\n      </button>\n      <div\n        className=\"dropdown-container\"\n        style={{ display: showProjectsDropdown ? \"block\" : \"none\" }}\n      >\n        <a href=\"https://ttyltutors.com\">TTYL</a>\n        <a href=\"https://www.pearlrae.com\">Pearl Rae</a>\n        <a href=\"https://jimmyjamkalewraps.com\">Jimmy Jam Kale Wrap</a>\n        <a href=\"https://tix.wellcall.biz\">We'll Call Tix</a>\n      </div>\n      <button\n        onClick={() => setShowSocialDropdown(!showSocialDropdown)}\n        className=\"dropdown-btn\"\n      >\n        <UsergroupAddOutlined /> Social\n        <CaretDownOutlined className={\"fa-caret-down\"} />\n      </button>\n      <div\n        className=\"dropdown-container\"\n        style={{ display: showSocialDropdown ? \"block\" : \"none\" }}\n      >\n        <a\n          href=\"https://www.facebook.com/WellCallTechConsulting\"\n          target={\"_blank\"}\n        >\n          <FacebookOutlined /> Facebook\n        </a>\n        <a href=\"https://www.instagram.com/d.o.n._tomlin/\" target={\"_blank\"}>\n          <InstagramOutlined /> Instagram\n        </a>\n      </div>\n    </div>\n  );\n}\n","/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/consulting.wellcall.biz/src/main/about/about.tsx",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/consulting.wellcall.biz/src/main/services/services.tsx",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/consulting.wellcall.biz/src/main/packages/packages.tsx",[],{"ruleId":"45","replacedBy":"46"},{"ruleId":"47","replacedBy":"48"},{"ruleId":"49","severity":1,"message":"50","line":3,"column":50,"nodeType":"51","messageId":"52","endLine":3,"endColumn":54},{"ruleId":"53","severity":1,"message":"54","line":23,"column":11,"nodeType":"55","endLine":23,"endColumn":53},{"ruleId":"53","severity":1,"message":"54","line":17,"column":11,"nodeType":"55