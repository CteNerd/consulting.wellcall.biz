{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Consulting production release assets only. No roles, executor, users or development resources. Deploy only in us-east-1 after owner review.",
  "Resources": {
    "ReleaseAssets": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "rct-consulting-production-release-assets-${AWS::AccountId}-us-east-1"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            { "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }
          ]
        },
        "VersioningConfiguration": { "Status": "Enabled" },
        "OwnershipControls": {
          "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          { "Key": "Application", "Value": "Consulting" },
          { "Key": "Environment", "Value": "production" },
          { "Key": "Purpose", "Value": "release-assets" }
        ]
      }
    },
    "ReleaseAssetsTlsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Bucket": { "Ref": "ReleaseAssets" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                { "Fn::GetAtt": ["ReleaseAssets", "Arn"] },
                { "Fn::Sub": "${ReleaseAssets.Arn}/*" }
              ],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "ReleaseAssetsBucket": { "Value": { "Ref": "ReleaseAssets" } },
    "FileAssetPrefix": { "Value": "release/" }
  }
}
